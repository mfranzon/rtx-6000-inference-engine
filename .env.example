# Copy to .env and edit. Everything is optional.

# Where the 16.5 GB model lives. Point at an existing download to skip it (expects <dir>/inkling2/<file>.ninfer).
# MODEL_DIR=./models
# MODEL_DIR=/srv/ai/ninfer

# 1 = one client (agent/chat): DSpark speculative decoding, ~80-115 tok/s, 128K context.
# 4 = several clients: no drafting, ~147 tok/s aggregate; use MAX_CONTEXT=32768 so all lanes fit in 24 GB.
# MAX_CONCURRENCY=1
# MAX_CONTEXT=131072

# Set VISION=--no-vision to free ~0.6 GB when you only need text.
# VISION=--vision

# BIND=127.0.0.1     # 0.0.0.0 exposes the API on the network: it has no authentication
# PORT=9000
# GPU=0
# MODEL_ID=Inkling-2-Mini-UD-IQ4_XS-ninfer-v3
# HF_TOKEN=
